{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": true
  },
  "Auth": {
    "RequireHttpsCookies": true,
    "SessionHours": 8
  },
  "RateLimit": {
    "LoginPerMinute": 10
  }
}
